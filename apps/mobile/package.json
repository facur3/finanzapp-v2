{
  "name": "@finanzapp/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "test:storage": "node --experimental-strip-types --test tests/*.node.ts",
    "export:ios": "expo export --platform ios",
    "check": "expo install --check",
    "i18n:check": "node --experimental-strip-types scripts/i18n/check.mjs",
    "i18n:extract": "node --experimental-strip-types scripts/i18n/extract.mjs",
    "i18n:export": "node --experimental-strip-types scripts/i18n/export.mjs",
    "currency:generate": "node --experimental-strip-types scripts/currency/generate.mjs",
    "currency:verify": "node --experimental-strip-types scripts/currency/generate.mjs --verify",
    "regions:generate": "node --experimental-strip-types scripts/regions/generate.mjs",
    "regions:verify": "node --experimental-strip-types scripts/regions/generate.mjs --verify",
    "regions:families": "node --experimental-strip-types scripts/regions/families.mjs"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "overrides": {
    "query-string": {
      "decode-uri-component": "$decode-uri-component"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@finanzapp/domain": "file:../../packages/domain",
    "@react-native-community/datetimepicker": "9.1.0",
    "decode-uri-component": "file:./compat/decode-uri-component",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.23",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "safe-decode-uri-component": "npm:decode-uri-component@0.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "~19.2.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
