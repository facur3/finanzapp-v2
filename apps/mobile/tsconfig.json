{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["**/*.ts", "**/*.tsx", "../../packages/domain/**/*.ts"],
  "exclude": ["node_modules", "../../packages/domain/**/*.test.ts"]
}
